# Go / Wails
/bin/
*.syso
*.exe
*.test
*.out

# 前端构建产物同步目录（由 pnpm sync:wails 生成）
/web/dist/*
!/web/dist/.gitkeep

# 生成的 Wails bindings 随仓库提交（Go 签名变更后用 `wails3 task bindings` 重新生成）

# 依赖 / 编辑器
node_modules/
.DS_Store
.idea/
.vscode/
*.log

# 本地运行时数据（不进入仓库）
*.db
*.db-shm
*.db-wal

# Task runner cache
/.task/
