<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleNotes.Desktop.ViewModels"
        x:Class="SimpleNotes.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="720"
        MinWidth="760" MinHeight="500">
    <!-- 骨架占位：页面信息架构待功能设计确定 -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Status}" FontSize="13" Opacity="0.6"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Window>
