<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="simplenotes.exe"
        Arguments=""
        InstallLocation="C:\Program Files\naihao.cc\Simple Notes">
    </Installer>
    <PackageInformation
        PackageName="Simple Notes"
        PackageDisplayName="Simple Notes"
        PublisherName="CN=naihao.cc"
        PublisherDisplayName="naihao.cc"
        Version="0.1.0.0"
        PackageDescription="Simple Notes desktop">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="cc.naihao.simplenotes"
                Description="Simple Notes desktop"
                DisplayName="Simple Notes"
                ExecutableName="simplenotes.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Simple Notes</DisplayName>
            <PublisherDisplayName>naihao.cc</PublisherDisplayName>
            <Description>Simple Notes desktop</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="simplenotes.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
