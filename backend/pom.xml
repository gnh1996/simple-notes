<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cc.naihao</groupId>
    <artifactId>simple-notes</artifactId>
    <!-- 发布版本唯一来源：Git tag（docs/release.md）。
         本地默认 0.0.0-dev；发布时用 -Drevision=<tag 去掉 v> 构建，
         版本号经 build-info 烘焙进 jar，由 GET /api/version 对外自证。 -->
    <version>${revision}</version>
    <name>simple-notes-backend</name>
    <description>随手记（Simple Notes）后端服务</description>

    <!--
      不继承 spring-boot-starter-parent：
      - 依赖版本由 spring-boot-dependencies BOM 统一管理
      - 插件版本、编译器参数等原先由 parent 提供的默认值在此显式声明（保持 pom 自描述）
    -->
    <properties>
        <!-- 发布版本默认值（本地构建）；发布构建用 -Drevision 覆盖，见 docs/release.md -->
        <revision>0.0.0-dev</revision>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.1.1</spring-boot.version>
        <!-- OpenAPI 契约导出（v3 线对应 Spring Boot 4；不在 Boot BOM 内，需显式版本） -->
        <springdoc.version>3.1.1</springdoc.version>
        <!-- 注解处理器路径不参与 BOM 版本解析，需与 BOM 内 lombok.version 保持一致 -->
        <lombok.version>1.18.46</lombok.version>
        <!-- 与 Spring Boot BOM 内 querydsl.version 属性区分，避免同名歧义 -->
        <openfeign-querydsl.version>7.7</openfeign-querydsl.version>
        <!-- R2 / S3 兼容对象存储（Apache 2.0）；版本独立于 Spring Boot BOM -->
        <awssdk.version>2.57.8</awssdk.version>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              依赖安全覆盖（CVE 修复）。
              注意：BOM 导入方式下无法通过属性（如 tomcat.version）覆盖版本，必须在此显式声明条目。
              待 spring-boot-dependencies 补丁版抬升到不低于以下版本后可整段移除；核实记录见 docs/tech-stack.md。
            -->
            <dependency>
                <!-- CVE-2026-107314 / CVE-2026-107315，修复版本 42.7.14 -->
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.14</version>
            </dependency>
            <!-- Tomcat 11.0.25 修复 8 个 CVE，11.0.26 修复 CVE-2026-86350 / CVE-2026-77762，统一取 11.0.27 -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>11.0.27</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>11.0.27</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>11.0.27</version>
            </dependency>
            <!-- jackson-databind 3.1.6 / 3.1.7、jackson-core 3.1.7 为各 CVE 的修复版本 -->
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>3.1.7</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>3.1.7</version>
            </dependency>
            <dependency>
                <!-- 6 个 CVE 统一在 9.11 修复；仅测试域 -->
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>9.11</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <!-- JWT 签发 / 校验（Nimbus，HS256）；版本随 spring-security-bom -->
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <!-- OpenAPI 契约导出（/v3/api-docs；只含 JSON 端点，不含 Swagger UI —— 前端生成客户端用） -->
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- 授权快照缓存 + 登录限流（版本随 BOM） -->
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.openfeign.querydsl</groupId>
            <artifactId>querydsl-jpa</artifactId>
            <version>${openfeign-querydsl.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- 集成测试用真实 PostgreSQL（Testcontainers；版本随 BOM） -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- 本地 spring-boot:run 默认启用 dev：asset-base 指向 Vite（HMR）。
                         生产 java -jar 不经过该 goal，仍使用 /blog。 -->
                    <profiles>
                        <profile>dev</profile>
                    </profiles>
                </configuration>
                <executions>
                    <!-- 原先由 spring-boot-starter-parent 绑定：打包可执行 fat jar -->
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                    <!-- 生成 META-INF/build-info.properties：版本号与构建时间烘焙进 jar，
                         由 GET /api/version 对外自证（docs/release.md）。缺失时（如 IDE 直接运行）
                         控制器回退到 APP_VERSION / 0.0.0-dev，不影响启动。 -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <!-- Spring Framework 6.1+ 依赖 -parameters 做参数名解析 -->
                    <parameters>true</parameters>
                    <!-- Java 23+ 须显式 proc=full，否则注解处理器（Lombok / QueryDSL APT）静默不执行 -->
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.github.openfeign.querydsl</groupId>
                            <artifactId>querydsl-apt</artifactId>
                            <version>${openfeign-querydsl.version}</version>
                            <classifier>jpa</classifier>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!--
                      把 blog 构建产物打进 jar（docs/blog-runtime-theme.md §5.3）：
                      - 只绑定 prepare-package，因此 mvn test / compile 不依赖 Node 与 dist
                      - 缺失产物直接失败，避免打出没有前端资源的空壳 jar
                    -->
                    <execution>
                        <id>copy-blog-assets</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <fail message="缺少 blog 构建产物：请先在 frontend/ 执行 pnpm build:blog">
                                    <condition>
                                        <not>
                                            <available file="${project.basedir}/../frontend/apps/blog/dist/runtime.js"/>
                                        </not>
                                    </condition>
                                </fail>
                                <delete dir="${project.build.outputDirectory}/static/blog"/>
                                <copy todir="${project.build.outputDirectory}/static/blog">
                                    <fileset dir="${project.basedir}/../frontend/apps/blog/dist">
                                        <exclude name="index.html"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
