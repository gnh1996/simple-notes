{
  "version": 1,
  "data": {
    "site": {
      "shape": "Site",
      "routes": "all"
    },
    "nav": {
      "shape": "NavItem[]",
      "routes": "all"
    },
    "route": {
      "shape": "RouteView",
      "routes": "all"
    },
    "state": {
      "shape": "'loading' | 'empty' | 'error' | 'ready'",
      "routes": "all"
    },
    "message": {
      "shape": "string",
      "routes": "all"
    },
    "colorMode": {
      "shape": "'light' | 'dark'",
      "routes": "all"
    },
    "posts": {
      "shape": "PostSummary[]",
      "routes": [
        "home",
        "tags",
        "tag-posts",
        "archives",
        "search"
      ]
    },
    "pager": {
      "shape": "Pager",
      "routes": [
        "home",
        "tags",
        "tag-posts",
        "archives",
        "search"
      ]
    },
    "post": {
      "shape": "PostDetail | null",
      "routes": [
        "post"
      ]
    },
    "prevPost": {
      "shape": "PostSummary | null",
      "routes": [
        "post"
      ]
    },
    "nextPost": {
      "shape": "PostSummary | null",
      "routes": [
        "post"
      ]
    },
    "tags": {
      "shape": "Tag[]",
      "routes": [
        "tags",
        "tag-posts"
      ]
    },
    "tag": {
      "shape": "Tag | null",
      "routes": [
        "tag-posts"
      ]
    },
    "archives": {
      "shape": "Archive[]",
      "routes": [
        "archives"
      ]
    },
    "archiveGroups": {
      "shape": "ArchiveGroup[]",
      "routes": [
        "archives"
      ]
    },
    "keyword": {
      "shape": "string",
      "routes": [
        "search"
      ]
    },
    "searched": {
      "shape": "boolean",
      "routes": [
        "search"
      ]
    },
    "page": {
      "shape": "SitePage | null",
      "routes": [
        "page"
      ]
    },
    "listSort": {
      "shape": "ListSort",
      "routes": "all",
      "note": "当前列表 / 详情上下文解析后的排序参数（只读）"
    },
    "ui": {
      "shape": "Record<string, unknown>",
      "routes": "all",
      "writable": true,
      "note": "主题自有 UI 状态（抽屉 / 标签页 / 筛选），可 v-model；路由切换时清空，不持久化"
    }
  },
  "helpers": {
    "isNavActive": {
      "signature": "(to: string): boolean"
    },
    "formatDate": {
      "signature": "(value: string | null | undefined): string"
    },
    "postDate": {
      "signature": "(post: PostSummary): string"
    }
  },
  "actions": {
    "go": {
      "signature": "(page: number): void"
    },
    "search": {
      "signature": "(keyword: string): void"
    },
    "setColorMode": {
      "signature": "(mode: 'light' | 'dark' | 'system'): void"
    },
    "toggleColorMode": {
      "signature": "(): void"
    },
    "scrollToTop": {
      "signature": "(): void"
    },
    "openLightbox": {
      "signature": "(src: string, alt?: string): void"
    }
  },
  "components": {
    "blog-post-card": {
      "props": [
        "post"
      ],
      "requiredProps": [
        "post"
      ],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-card",
        "bc-card-cover",
        "bc-card-body",
        "bc-card-meta",
        "bc-card-pin",
        "bc-card-title",
        "bc-card-summary",
        "bc-card-tags"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "post"
          ],
          "scope": [
            {
              "name": "post",
              "shape": "PostSummary"
            }
          ]
        },
        {
          "name": "default",
          "provides": [
            "post"
          ],
          "scope": [
            {
              "name": "post",
              "shape": "PostSummary"
            }
          ]
        }
      ],
      "example": "<blog-post-card v-for=\"item in posts\" :key=\"item.slug\" :post=\"item\" />"
    },
    "blog-pager": {
      "props": [
        "pager"
      ],
      "requiredProps": [
        "pager"
      ],
      "events": [
        "go"
      ],
      "selfFetch": false,
      "parts": [
        "bc-pager"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "pager",
            "go",
            "pages"
          ],
          "scope": [
            {
              "name": "pager",
              "shape": "Pager"
            },
            {
              "name": "go",
              "shape": "(page: number) => void"
            },
            {
              "name": "pages",
              "shape": "number[]"
            }
          ]
        }
      ],
      "example": "<blog-pager :pager=\"pager\" v-slot:root=\"{ pager, go, pages }\">\n  <button v-for=\"page in pages\" :key=\"page\" :disabled=\"page === pager.page\" @click=\"go(page)\">{{ page }}</button>\n</blog-pager>"
    },
    "blog-markdown": {
      "props": [
        "source"
      ],
      "requiredProps": [],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-prose"
      ],
      "slots": [],
      "example": "<blog-markdown :source=\"post.content\" />"
    },
    "blog-toc": {
      "props": [],
      "requiredProps": [],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-toc"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "items",
            "activeId",
            "scrollTo"
          ],
          "scope": [
            {
              "name": "items",
              "shape": "TocItem[]"
            },
            {
              "name": "activeId",
              "shape": "string"
            },
            {
              "name": "scrollTo",
              "shape": "(id: string) => void"
            }
          ]
        }
      ],
      "example": "<blog-toc v-slot:root=\"{ items, activeId, scrollTo }\">\n  <a v-for=\"item in items\" :key=\"item.id\" :href=\"'#' + item.id\" @click.prevent=\"scrollTo(item.id)\">{{ item.text }}</a>\n</blog-toc>"
    },
    "blog-tag-chip": {
      "props": [
        "tag"
      ],
      "requiredProps": [
        "tag"
      ],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-tag"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "tag"
          ],
          "scope": [
            {
              "name": "tag",
              "shape": "TagBrief"
            }
          ]
        }
      ],
      "example": "<blog-tag-chip v-for=\"tag in post.tags\" :key=\"tag.id\" :tag=\"tag\" />"
    },
    "blog-tag-cloud": {
      "props": [],
      "requiredProps": [],
      "events": [],
      "selfFetch": true,
      "parts": [
        "bc-tag-cloud",
        "bc-tag",
        "bc-tag-count",
        "bc-state"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "tags",
            "state",
            "message"
          ],
          "scope": [
            {
              "name": "tags",
              "shape": "Tag[]"
            },
            {
              "name": "state",
              "shape": "string"
            },
            {
              "name": "message",
              "shape": "string"
            }
          ]
        }
      ],
      "example": "<blog-tag-cloud />"
    },
    "blog-archives": {
      "props": [],
      "requiredProps": [],
      "events": [],
      "selfFetch": true,
      "parts": [
        "archive-index",
        "bc-state"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "archives",
            "state",
            "message"
          ],
          "scope": [
            {
              "name": "archives",
              "shape": "Archive[]"
            },
            {
              "name": "state",
              "shape": "string"
            },
            {
              "name": "message",
              "shape": "string"
            }
          ]
        }
      ],
      "example": "<blog-archives />"
    },
    "blog-search-box": {
      "props": [
        "value"
      ],
      "requiredProps": [],
      "events": [
        "search"
      ],
      "selfFetch": false,
      "parts": [
        "bc-search"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "value",
            "search"
          ],
          "scope": [
            {
              "name": "value",
              "shape": "string"
            },
            {
              "name": "search",
              "shape": "(value: string) => void"
            }
          ]
        }
      ],
      "example": "<blog-search-box :value=\"keyword\" @search=\"search\" />"
    },
    "blog-theme-toggle": {
      "props": [],
      "requiredProps": [],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-theme-toggle"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "colorMode",
            "toggle",
            "set"
          ],
          "scope": [
            {
              "name": "colorMode",
              "shape": "'light' | 'dark'"
            },
            {
              "name": "toggle",
              "shape": "() => void"
            },
            {
              "name": "set",
              "shape": "(mode: 'light' | 'dark' | 'system') => void"
            }
          ]
        }
      ],
      "example": "<blog-theme-toggle v-slot:root=\"{ colorMode, toggle }\">\n  <button type=\"button\" @click=\"toggle\">{{ colorMode === 'dark' ? '浅色' : '深色' }}</button>\n</blog-theme-toggle>"
    },
    "blog-image": {
      "props": [
        "src",
        "alt"
      ],
      "requiredProps": [
        "src"
      ],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-image"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "src",
            "alt",
            "open"
          ],
          "scope": [
            {
              "name": "src",
              "shape": "string"
            },
            {
              "name": "alt",
              "shape": "string"
            },
            {
              "name": "open",
              "shape": "() => void"
            }
          ]
        }
      ],
      "example": "<blog-image :src=\"post.coverUrl\" :alt=\"post.title\" />"
    },
    "blog-back-to-top": {
      "props": [],
      "requiredProps": [],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-back-to-top"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "visible",
            "scroll"
          ],
          "scope": [
            {
              "name": "visible",
              "shape": "boolean"
            },
            {
              "name": "scroll",
              "shape": "() => void"
            }
          ]
        }
      ],
      "example": "<blog-back-to-top v-slot:root=\"{ visible, scroll }\">\n  <button v-if=\"visible\" type=\"button\" @click=\"scroll\">回到顶部</button>\n</blog-back-to-top>"
    },
    "blog-reading-progress": {
      "props": [],
      "requiredProps": [],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-reading-progress"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "progress"
          ],
          "scope": [
            {
              "name": "progress",
              "shape": "number"
            }
          ]
        }
      ],
      "example": "<blog-reading-progress v-slot:root=\"{ progress }\">\n  <div :style=\"{ transform: 'scaleX(' + progress + ')' }\"></div>\n</blog-reading-progress>"
    },
    "blog-state": {
      "props": [
        "state",
        "message"
      ],
      "requiredProps": [],
      "events": [],
      "selfFetch": false,
      "parts": [
        "bc-state",
        "bc-skeleton"
      ],
      "slots": [
        {
          "name": "root",
          "provides": [
            "state",
            "message"
          ],
          "scope": [
            {
              "name": "state",
              "shape": "string"
            },
            {
              "name": "message",
              "shape": "string"
            }
          ]
        }
      ],
      "example": "<blog-state :state=\"state\" :message=\"message\" />"
    }
  },
  "expression": {
    "globals": [
      "Math",
      "Number",
      "String",
      "Boolean",
      "Array",
      "Object",
      "JSON",
      "Intl",
      "Date",
      "parseInt",
      "parseFloat",
      "isNaN",
      "isFinite",
      "encodeURI",
      "encodeURIComponent",
      "decodeURI",
      "decodeURIComponent"
    ],
    "eventLocals": [
      "$event"
    ],
    "eventModifiers": [
      "stop",
      "prevent",
      "once",
      "self",
      "capture",
      "passive",
      "enter",
      "tab",
      "esc",
      "space",
      "up",
      "down",
      "left",
      "right",
      "delete"
    ],
    "modelModifiers": [
      "lazy",
      "number",
      "trim"
    ],
    "nativeEvents": [
      "click",
      "dblclick",
      "input",
      "change",
      "submit",
      "reset",
      "keydown",
      "keyup",
      "keypress",
      "focus",
      "blur",
      "focusin",
      "focusout",
      "mouseenter",
      "mouseleave",
      "mouseover",
      "mouseout",
      "mousedown",
      "mouseup",
      "mousemove",
      "contextmenu",
      "wheel",
      "scroll",
      "touchstart",
      "touchend",
      "touchmove",
      "paste",
      "copy",
      "cut"
    ]
  },
  "globalParts": [
    "bc-lightbox"
  ],
  "cssVars": [
    "--blog-accent",
    "--blog-accent-contrast",
    "--blog-bg",
    "--blog-surface",
    "--blog-text",
    "--blog-text-muted",
    "--blog-border",
    "--blog-radius",
    "--blog-font-sans",
    "--blog-font-mono",
    "--blog-prose-size",
    "--blog-prose-line-height",
    "--blog-content-width",
    "--blog-gap",
    "--blog-code-bg"
  ],
  "directives": [
    "v-if",
    "v-else-if",
    "v-else",
    "v-for",
    "v-show",
    "v-model",
    "v-text",
    "v-once",
    "v-cloak",
    "v-bind",
    "v-on",
    "v-slot"
  ],
  "routes": {
    "home": {
      "path": "/",
      "query": []
    },
    "post": {
      "path": "/posts/:slug",
      "query": []
    },
    "tags": {
      "path": "/tags",
      "query": [
        "page",
        "size",
        "sortBy",
        "direction",
        "pinnedFirst"
      ]
    },
    "tag-posts": {
      "path": "/tags/:id",
      "query": [
        "page",
        "size",
        "sortBy",
        "direction",
        "pinnedFirst"
      ]
    },
    "archives": {
      "path": "/archives",
      "query": [
        "year",
        "month",
        "page",
        "size",
        "sortBy",
        "direction",
        "pinnedFirst"
      ]
    },
    "search": {
      "path": "/search",
      "query": [
        "q",
        "page",
        "size",
        "sortBy",
        "direction",
        "pinnedFirst"
      ]
    },
    "page": {
      "path": "/p/:slug",
      "alias": [
        "/about"
      ],
      "query": []
    },
    "not-found": {
      "path": "/:pathMatch(.*)*",
      "query": []
    }
  },
  "urls": {
    "post": "/posts/{slug}",
    "tag": "/tags/{id}",
    "archives": "/archives?year={year}&month={month}",
    "search": "/search?q={q}",
    "page": "/p/{slug}"
  },
  "types": {
    "Archive": {
      "year": "number",
      "month": "number",
      "count": "number"
    },
    "ArchiveGroup": {
      "key": "string",
      "year": "number",
      "month": "number",
      "posts": "PostSummary[]"
    },
    "Author": {
      "name": "string",
      "avatarUrl": "string | null",
      "bio": "string"
    },
    "ListSort": {
      "pinnedFirst": "boolean",
      "direction": "'asc' | 'desc'",
      "sortBy": "SortField"
    },
    "NavItem": {
      "key": "string",
      "label": "string",
      "to": "string"
    },
    "Pager": {
      "page": "number",
      "size": "number",
      "total": "number",
      "totalPages": "number",
      "hasPrev": "boolean",
      "hasNext": "boolean"
    },
    "PostDetail": {
      "slug": "string",
      "title": "string",
      "summary": "string",
      "coverUrl": "string | null",
      "tags": "TagBrief[]",
      "pinned": "boolean",
      "firstPublishedAt": "string",
      "lastPublishedAt": "string",
      "authoredAt": "string | null",
      "displayAt": "string",
      "readingMinutes": "number",
      "content": "string",
      "authorName": "string",
      "prevPost": "PostSummary | null",
      "nextPost": "PostSummary | null"
    },
    "PostSummary": {
      "slug": "string",
      "title": "string",
      "summary": "string",
      "coverUrl": "string | null",
      "tags": "TagBrief[]",
      "pinned": "boolean",
      "firstPublishedAt": "string",
      "lastPublishedAt": "string",
      "authoredAt": "string | null",
      "displayAt": "string",
      "readingMinutes": "number"
    },
    "RouteView": {
      "name": "string | symbol | null | undefined",
      "path": "string",
      "params": "Record<string, string | string[]>",
      "query": "Record<string, string | string[] | null>",
      "hash": "string"
    },
    "Site": {
      "name": "string",
      "tagline": "string",
      "description": "string",
      "logoUrl": "string | null",
      "faviconUrl": "string | null",
      "baseUrl": "string | null",
      "icp": "string | null",
      "policeRecord": "string | null",
      "author": "Author",
      "social": "SocialLink[]",
      "nav": "NavItem[]",
      "themeMode": "string",
      "themeOverrides": "Record<string, string> | null",
      "footerText": "string",
      "pageSize": "number"
    },
    "SitePage": {
      "id": "string",
      "slug": "string",
      "title": "string",
      "content": "string",
      "visible": "boolean",
      "sort": "number",
      "updatedAt": "string"
    },
    "SocialLink": {
      "type": "string | null",
      "label": "string | null",
      "url": "string | null"
    },
    "SortField": "'displayAt' | 'firstPublishedAt' | 'lastPublishedAt'",
    "Tag": {
      "id": "string",
      "name": "string",
      "count": "number"
    },
    "TagBrief": {
      "id": "string",
      "name": "string"
    },
    "TocItem": {
      "id": "string",
      "text": "string",
      "depth": "number"
    }
  },
  "skeleton": {
    "html": "<div id=\"app\" :data-blog-page=\"route.name\" :data-state=\"state\">\n  <header class=\"shell-head\">\n    <a class=\"brand\" href=\"/\">{{ site.name }}</a>\n    <nav aria-label=\"主导航\">\n      <a v-for=\"item in nav\" :key=\"item.key\" :href=\"item.to\"\n         :aria-current=\"isNavActive(item.to) ? 'page' : undefined\">{{ item.label }}</a>\n    </nav>\n    <blog-theme-toggle></blog-theme-toggle>\n  </header>\n\n  <main class=\"shell-main\">\n    <template v-if=\"route.name === 'home'\">\n      <blog-state v-if=\"state !== 'ready'\" :state=\"state\" :message=\"message\"></blog-state>\n      <template v-else>\n        <article v-for=\"item in posts\" :key=\"item.slug\" class=\"post-item\">\n          <h2><a :href=\"'/posts/' + item.slug\">{{ item.title }}</a></h2>\n          <p>{{ item.summary }}</p>\n          <time :datetime=\"postDate(item)\">{{ formatDate(postDate(item)) }}</time>\n        </article>\n        <blog-pager :pager=\"pager\" @go=\"go\"></blog-pager>\n      </template>\n    </template>\n\n    <template v-else-if=\"route.name === 'post'\">\n      <blog-state v-if=\"state !== 'ready'\" :state=\"state\" :message=\"message\"></blog-state>\n      <article v-else-if=\"post\" class=\"post-detail\">\n        <h1>{{ post.title }}</h1>\n        <p>{{ formatDate(post.displayAt) }} · {{ post.readingMinutes }} 分钟</p>\n        <blog-markdown :source=\"post.content\"></blog-markdown>\n      </article>\n    </template>\n\n    <template v-else>\n      <h1>{{ page ? page.title : '页面不存在' }}</h1>\n      <blog-markdown v-if=\"page\" :source=\"page.content\"></blog-markdown>\n    </template>\n  </main>\n</div>",
    "css": ":root {\n  --blog-bg: #ffffff;\n  --blog-text: #1f2328;\n  --blog-text-muted: #6b7280;\n  --blog-accent: #b23a2f;\n  --blog-border: #e5e7eb;\n  --blog-content-width: 68rem;\n  --blog-gap: 1.5rem;\n}\n\n[data-color-mode=\"dark\"] {\n  --blog-bg: #16181d;\n  --blog-text: #e6e6e6;\n  --blog-text-muted: #9ca3af;\n  --blog-accent: #e07a5f;\n  --blog-border: #2a2e37;\n}\n\nbody {\n  margin: 0;\n  background: var(--blog-bg);\n  color: var(--blog-text);\n}\n\n.shell-head,\n.shell-main {\n  max-width: var(--blog-content-width);\n  margin: 0 auto;\n  padding: var(--blog-gap);\n}\n\n.shell-head {\n  display: flex;\n  align-items: center;\n  gap: var(--blog-gap);\n  border-bottom: 1px solid var(--blog-border);\n}\n\n.post-item {\n  padding: var(--blog-gap) 0;\n  border-bottom: 1px solid var(--blog-border);\n}\n\n.post-item time {\n  color: var(--blog-text-muted);\n}"
  }
}
