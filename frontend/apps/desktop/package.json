{
  "name": "@simple-notes/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm sync:vditor && vite",
    "build": "pnpm sync:vditor && vue-tsc -b && vite build",
    "build:dev": "pnpm sync:vditor && vue-tsc -b && vite build --minify false --mode development",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "sync:wails": "node scripts/sync-wails.mjs",
    "sync:vditor": "node ../../scripts/sync-vditor-assets.mjs"
  },
  "dependencies": {
    "@simple-notes/api": "workspace:*",
    "@simple-notes/markdown": "workspace:*",
    "@simple-notes/shared": "workspace:*",
    "@simple-notes/ui": "workspace:*",
    "@wailsio/runtime": "catalog:",
    "vditor": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
}
