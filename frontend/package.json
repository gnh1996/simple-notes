{
  "name": "simple-notes-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @simple-notes/admin dev",
    "dev:blog": "pnpm --filter @simple-notes/blog dev",
    "dev:desktop": "pnpm --filter @simple-notes/desktop dev",
    "build": "pnpm -r --if-present build",
    "build:admin": "pnpm --filter @simple-notes/admin build",
    "build:blog": "pnpm --filter @simple-notes/blog build",
    "build:desktop": "pnpm --filter @simple-notes/desktop build",
    "gen:api": "pnpm --filter @simple-notes/api gen:api",
    "sync:theme": "node scripts/sync-theme-starter.mjs",
    "check:theme": "node scripts/sync-theme-starter.mjs --check",
    "check:contract": "node scripts/theme-contract.mjs",
    "sync:contract": "node scripts/theme-contract.mjs --emit",
    "typecheck": "pnpm check:theme && pnpm check:contract && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@vue/tsconfig": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:"
  }
}
