# 复制为 .env，或直接运行 scripts/init-env.sh 生成随机值
POSTGRES_DB=simple_notes
POSTGRES_USER=simple_notes
POSTGRES_PASSWORD=
JWT_SECRET=
ROOT_INITIAL_PASSWORD=

# ---- 外部数据库（可选）----
# 填好后用：docker compose up -d --no-deps app web
# DB_URL=jdbc:postgresql://db.example.com:5432/simple_notes
# DB_USERNAME=simple_notes
# DB_PASSWORD=change-me

# ---- 端口 / 访问源 ----
# SIMPLE_NOTES_PORT=8080
# APP_PORT=8081
# 同机裸机 nginx 保持 127.0.0.1；远程 nginx 改为 0.0.0.0（并配防火墙）
# APP_BIND=127.0.0.1
# ADMIN_ORIGIN=http://localhost:8080

# ---- 可选：主题 AI ----
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# ---- 可选：媒体存储 ----
# STORAGE_MODE=LOCAL
# MEDIA_PUBLIC_BASE_URL=
# STORAGE_URL_MODE=DIRECT
